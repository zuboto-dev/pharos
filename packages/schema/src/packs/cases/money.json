  "queryChecks": [
    {
      "id": "money-mixed-currency-sum",
      "version": 1,
      "pack": "money",
      "description": "A sum over spending in two currencies is allowed and shows two totals",
      "tags": ["currency", "allowed"],
      "widgets": [
        {
          "id": "w",
          "node": {
            "component": "Stat",
            "label": "Spent",
            "query": { "type": "record", "where": { "recordType": "spending" } },
            "sum": "fields.amount"
          }
        }
      ],
      "expect": "accept"
    },
    {
      "id": "money-range-on-money",
      "version": 1,
      "pack": "money",
      "description": "A range straight on a money field is refused; .amount (in cents) is the way",
      "tags": ["operator-mismatch", "money"],
      "widgets": [
        {
          "id": "w",
          "node": {
            "component": "DataList",
            "query": {
              "type": "record",
              "where": { "recordType": "spending", "fields.amount": { "gt": 100 } }
            }
          }
        }
      ],
      "expect": "reject",
      "codes": ["operator-mismatch"]
    },
    {
      "id": "money-amount-range",
      "version": 1,
      "pack": "money",
      "description": "A range on fields.amount.amount (cents) is allowed",
      "tags": ["money", "allowed"],
      "widgets": [
        {
          "id": "w",
          "node": {
            "component": "DataList",
            "query": {
              "type": "record",
              "where": { "recordType": "spending", "fields.amount.amount": { "gt": 5000 } }
            }
          }
        }
      ],
      "expect": "accept"
    },
    {
      "id": "money-no-record-type",
      "version": 1,
      "pack": "money",
      "description": "A record query without a record type only warns",
      "tags": ["no-record-type", "warn"],
      "widgets": [
        { "id": "w", "node": { "component": "DataList", "query": { "type": "record" } } }
      ],
      "expect": "accept",
      "codes": ["no-record-type"]
    },
    {
      "id": "money-mixed-valid-invalid",
      "version": 1,
      "pack": "money",
      "description": "One bad block among good ones refuses the whole page",
      "tags": ["mixed"],
      "widgets": [
        {
          "id": "good",
          "node": {
            "component": "DataList",
            "query": { "type": "record", "where": { "recordType": "bill" } }
          }
        },
        {
          "id": "bad",
          "node": {
            "component": "CategoryBreakdown",
            "categories": { "type": "record", "where": { "recordType": "category" } },
            "planned": "fields.plan",
            "spent": {
              "query": { "type": "record", "where": { "recordType": "spending" } },
              "by": "fields.category",
              "sum": "fields.amount"
            }
          }
        }
      ],
      "expect": "reject",
      "codes": ["unknown-sum-field"]
    }
  ]
