  "queryChecks": [
    {
      "id": "company-expiry-typo",
      "version": 1,
      "pack": "company",
      "description": "A file field that doesn't exist (expiry) is refused with expiryDate as the fix",
      "tags": ["files", "unknown-field"],
      "widgets": [
        {
          "id": "w",
          "node": {
            "component": "DueTracker",
            "query": { "type": "file", "where": { "expiry": { "exists": true } } }
          }
        }
      ],
      "expect": "reject",
      "codes": ["unknown-field"]
    },
    {
      "id": "company-date-on-text",
      "version": 1,
      "pack": "company",
      "description": "A DueTracker date on a text field (authority) is refused",
      "tags": ["date", "operator-mismatch"],
      "widgets": [
        {
          "id": "w",
          "node": {
            "component": "DueTracker",
            "query": { "type": "record", "where": { "recordType": "renewal" } },
            "date": "fields.authority"
          }
        }
