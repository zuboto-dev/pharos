  "queryChecks": [
    {
      "id": "car-typo-record-field",
      "version": 1,
      "pack": "car",
      "description": "A typo'd record field is refused with the intended suggestion",
      "tags": ["unknown-field", "suggestion"],
      "widgets": [
        {
          "id": "w",
          "node": {
            "component": "DataTable",
            "query": {
              "type": "record",
              "where": { "recordType": "service", "fields.odomter": { "gte": 50000 } }
            },
            "columns": [{ "field": "title" }]
          }
        }
      ],
      "expect": "reject",
      "codes": ["unknown-field"]
    },
    {
      "id": "car-sum-over-text",
      "version": 1,
      "pack": "car",
      "description": "A sum over a text field is refused",
      "tags": ["sum-not-number"],
      "widgets": [
        {
          "id": "w",
          "node": {
            "component": "Stat",
            "label": "Shops",
            "query": { "type": "record", "where": { "recordType": "service" } },
            "sum": "fields.shop"
          }
        }
      ],
      "expect": "reject",
      "codes": ["sum-not-number"]
    },
    {
      "id": "car-intentional-empty",
      "version": 1,
      "pack": "car",
      "description": "Only past-due reminders: an empty result on a good day is fine",
      "tags": ["empty", "allowed"],
      "widgets": [
        {
          "id": "w",
          "node": {
            "component": "DueTracker",
            "query": { "type": "record", "where": { "recordType": "reminder" } },
            "bands": ["past_due"]
          }
        }
      ],
      "expect": "accept"
    },
    {
      "id": "car-custom-option",
      "version": 1,
      "pack": "car",
      "description": "The pack's own option values (file kind registration, service kind papers) are allowed",
      "tags": ["custom-option", "allowed"],
      "widgets": [
        {
          "id": "files",
          "node": { "component": "FileList", "filter": { "where": { "kind": "registration" } } }
        },
        {
          "id": "papers",
          "node": {
            "component": "DataList",
            "query": {
              "type": "record",
              "where": { "recordType": "reminder", "fields.kind": "papers" }
            }
          }
        }
      ],
      "expect": "accept"
    },
    {
      "id": "car-option-typo",
      "version": 1,
      "pack": "car",
      "description": "A record option value that doesn't exist is refused",
      "tags": ["unknown-option"],
      "widgets": [
        {
          "id": "w",
          "node": {
            "component": "DataList",
            "query": {
              "type": "record",
              "where": { "recordType": "service", "fields.kind": "brakess" }
            }
          }
        }
      ],
      "expect": "reject",
      "codes": ["unknown-option"]
    },
    {
      "id": "car-unknown-record-type",
      "version": 1,
      "pack": "car",
      "description": "A record type the project doesn't have is refused",
      "tags": ["unknown-record-type"],
      "widgets": [
        {
          "id": "w",
          "node": {
            "component": "DataList",
            "query": { "type": "record", "where": { "recordType": "servce" } }
          }
        }
      ],
      "expect": "reject",
      "codes": ["unknown-record-type"]
    },
    {
      "id": "car-bad-relative-date",
      "version": 1,
      "pack": "car",
      "description": "A relative date Pharos can't read is refused",
      "tags": ["bad-relative-date"],
      "widgets": [
        {
          "id": "w",
          "node": {
            "component": "DataList",
            "query": {
              "type": "record",
              "where": { "recordType": "service", "fields.date": { "gte": "$today-1x" } }
            }
          }
        }
      ],
      "expect": "reject",
      "codes": ["bad-relative-date"]
    },
    {
      "id": "car-hop-too-far",
      "version": 1,
      "pack": "car",
      "description": "Following two references is refused; one is allowed",
      "tags": ["unknown-hop"],
      "widgets": [
        {
          "id": "w",
          "node": {
            "component": "DataTable",
            "query": { "type": "record", "where": { "recordType": "service" } },
            "columns": [
              { "field": "fields.vehicle.fields.odometer" },
              { "field": "fields.vehicle.fields.make.x" }
            ]
          }
        }
      ],
      "expect": "reject",
      "codes": ["unknown-column"]
    }
  ]
