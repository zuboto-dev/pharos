  "queryChecks": [
    {
      "id": "study-target-typo",
      "version": 1,
      "pack": "study",
      "description": "A planned field the subject doesn't have is refused",
      "tags": ["unknown-sum-field"],
      "widgets": [
        {
          "id": "w",
          "node": {
            "component": "CategoryBreakdown",
            "categories": { "type": "record", "where": { "recordType": "subject" } },
            "planned": "fields.targets",
            "spent": {
              "query": { "type": "record", "where": { "recordType": "session" } },
              "by": "fields.subject",
              "sum": "fields.hours"
            },
            "aim": "target"
          }
        }
      ],
      "expect": "reject",
      "codes": ["unknown-sum-field"]
    },
    {
      "id": "study-date-not-a-date",
