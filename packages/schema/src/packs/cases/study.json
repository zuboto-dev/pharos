      "tags": ["date", "operator-mismatch"],
      "widgets": [
        {
          "id": "w",
          "node": {
            "component": "DueTracker",
            "query": { "type": "record", "where": { "recordType": "exam" } },
            "date": "fields.place"
          }
        }
      ],
      "expect": "reject",
      "codes": ["operator-mismatch"]
    },
    {
      "id": "study-date-ok",
      "version": 1,
      "pack": "study",
      "description": "A DueTracker over exams by their date field is allowed",
      "tags": ["date", "allowed"],
      "widgets": [
        {
          "id": "w",
          "node": {
            "component": "DueTracker",
            "query": {
              "type": "record",
