  "cases": [
    {
      "id": "money-planned-vs-spent",
      "version": 2,
      "pack": "money",
      "description": "Planned against spent per category this month, with an overspent category, spending without a category and the totals",
      "tags": ["categories", "sum", "month"],
      "today": "2026-10-13",
      "fixture": "october",
      "facts": [
        {
          "id": "groceries",
          "widget": "categories",
          "kind": "category",
          "category": "Groceries",
          "planned": [{ "amount": 40000, "currency": "EUR" }],
          "spent": [{ "amount": 23775, "currency": "EUR" }]
        },
        {
          "id": "eating-over",
          "widget": "categories",
          "kind": "category",
          "category": "Eating out",
          "planned": [{ "amount": 12000, "currency": "EUR" }],
